# Copy to .env.local for local use (npm run dev) or set these in Render → Environment.
# With EGNYTE_CLIENT_ID blank (or DEMO_MODE=true) the app runs in DEMO MODE using ./demo-data.

# ---------- App ----------
APP_URL=http://localhost:3000
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
DEMO_MODE=

# ---------- Egnyte ----------
EGNYTE_DOMAIN=gtmoran
EGNYTE_CLIENT_ID=
EGNYTE_CLIENT_SECRET=
EGNYTE_SCOPES=Egnyte.filesystem Egnyte.user Egnyte.webhooks
# Optional: only these email domains can sign in (comma separated), e.g. oferexpress.com
ALLOWED_EMAIL_DOMAINS=

# Folder layout (paths are inside EGNYTE_ROOT)
EGNYTE_ROOT=/Shared/Documents/LEASING APP
FOLDER_CONFIG=CONFIG
FOLDER_CURRENT_LEASES=CURRENT LEASES
FOLDER_PENDING_DEALS=PENDING Deals LOIs & Applications
FOLDER_DRAFTS=DRAFT LEASES
FOLDER_EXECUTED=EXECUTED NEW LEASES
TEMPLATE_A_PATH=TEMPLATES/Tagged/Template_A_Shipping_Docks.docx
TEMPLATE_B_PATH=TEMPLATES/Tagged/Template_B_Overhead_Doors.docx
# Optional exact file name of the master workbook in Config (default: first .xlsx found)
CONFIG_WORKBOOK=

# ---------- Lease defaults ----------
TOTAL_BUILDING_SQFT=159600
DEFAULT_NNN_RATE=2.65
LANDLORD_EMAIL=STucker@bradleyco.com
LANDLORD_SIGNER_NAME=
LANDLORD_SIGNER_TITLE=

# ---------- Anthropic (AI extraction) ----------
ANTHROPIC_API_KEY=
# claude-sonnet-4-20250514 was retired June 15, 2026 — claude-sonnet-5-5 is its replacement
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Email (draft review + executed copies) ----------
# resend | smtp | none   (none = the app opens your email app instead)
EMAIL_PROVIDER=none
EMAIL_FROM="Leasing <leasing@yourdomain.com>"
RESEND_API_KEY=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- Executed-lease automation ----------
# Random secret Egnyte sends with each webhook call: openssl rand -hex 32
WEBHOOK_AUTH_SECRET=
# Long-lived Egnyte token used by the webhook (Settings page → "Show my Egnyte token")
EGNYTE_SERVICE_TOKEN=
# A PDF in Draft Leases whose name matches this (case-insensitive) is treated as the signed copy
EXECUTED_FILE_PATTERN=signed|completed|executed|docusign

# ---------- PDF conversion ----------
# Leave blank to auto-detect soffice. Docker image: /usr/bin/soffice
LIBREOFFICE_PATH=
